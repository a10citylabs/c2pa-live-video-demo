{
    "name": "c2pa-live-segment-demo",
    "version": "1.0.0",
    "description": "Minimal dash.js demo: per-segment C2PA manifest verification with a Content Credentials overlay during playback.",
    "license": "BSD-3-Clause",
    "scripts": {
        "start": "http-server -p 8000 -c-1 .",
        "sync-dashjs": "cp node_modules/dashjs/dist/modern/umd/dash.all.min.js lib/dash.all.min.js && cp node_modules/dashjs/dist/modern/umd/dash.all.min.js.LICENSE.txt lib/",
        "build-merkle-manifest": "node scripts/build-merkle-manifest.js",
        "verify-merkle-manifest": "node scripts/verify-merkle-manifest.js"
    },
    "dependencies": {
        "dashjs": "5.2.0"
    },
    "devDependencies": {
        "http-server": "^14.1.1"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/a10citylabs/dash.js.git"
    }
}
